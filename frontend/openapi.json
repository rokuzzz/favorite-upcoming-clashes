{
  "openapi": "3.1.0",
  "info": {
    "title": "Favorite Upcoming Clashes",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/teams": {
      "get": {
        "summary": "List Teams",
        "operationId": "list_teams_api_teams_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Team"
                  },
                  "type": "array",
                  "title": "Response List Teams Api Teams Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/data-sources": {
      "get": {
        "summary": "List Data Sources",
        "operationId": "list_data_sources_api_data_sources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DataSource"
                  },
                  "type": "array",
                  "title": "Response List Data Sources Api Data Sources Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/matches": {
      "get": {
        "summary": "List Matches",
        "operationId": "list_matches_api_matches_get",
        "parameters": [
          {
            "name": "team",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Liiga team id, e.g. 624554857:lukko",
              "title": "Team"
            },
            "description": "Liiga team id, e.g. 624554857:lukko"
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Time horizon in days: 7, 14 or 21",
              "default": 14,
              "title": "Days"
            },
            "description": "Time horizon in days: 7, 14 or 21"
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated data sources, e.g. weather",
              "default": "",
              "title": "Include"
            },
            "description": "Comma-separated data sources, e.g. weather"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/preferences": {
      "get": {
        "summary": "Get Preferences",
        "operationId": "get_preferences_api_preferences_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences-Output"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save Preferences",
        "operationId": "save_preferences_api_preferences_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences-Output"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DataSource": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "title": "DataSource",
        "description": "An optional data source the user can show or hide."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MatchesResponse": {
        "properties": {
          "team": {
            "$ref": "#/components/schemas/Team"
          },
          "horizonDays": {
            "type": "integer",
            "title": "Horizondays"
          },
          "included": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Included"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/UpcomingMatch"
            },
            "type": "array",
            "title": "Matches"
          }
        },
        "type": "object",
        "required": [
          "team",
          "horizonDays",
          "included",
          "matches"
        ],
        "title": "MatchesResponse"
      },
      "Preferences-Input": {
        "properties": {
          "favouriteTeamId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Favouriteteamid"
          }
        },
        "type": "object",
        "title": "Preferences",
        "description": "What the user has saved. Owned by SettingsService."
      },
      "Preferences-Output": {
        "properties": {
          "favouriteTeamId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Favouriteteamid"
          }
        },
        "type": "object",
        "required": [
          "favouriteTeamId"
        ],
        "title": "Preferences",
        "description": "What the user has saved. Owned by SettingsService."
      },
      "Team": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "logoUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logourl"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "logoUrl"
        ],
        "title": "Team"
      },
      "UpcomingMatch": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "startUtc": {
            "type": "string",
            "format": "date-time",
            "title": "Startutc"
          },
          "startLocal": {
            "type": "string",
            "format": "date-time",
            "title": "Startlocal"
          },
          "opponent": {
            "$ref": "#/components/schemas/Team"
          },
          "isHome": {
            "type": "boolean",
            "title": "Ishome"
          },
          "venue": {
            "$ref": "#/components/schemas/Venue"
          },
          "weather": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WeatherForecast"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "startUtc",
          "startLocal",
          "opponent",
          "isHome",
          "venue",
          "weather"
        ],
        "title": "UpcomingMatch",
        "description": "A match seen from the chosen team's point of view, plus data from the requested data sources."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Venue": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          }
        },
        "type": "object",
        "required": [
          "name",
          "city",
          "latitude",
          "longitude"
        ],
        "title": "Venue"
      },
      "WeatherForecast": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "temperatureC": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temperaturec"
          },
          "precipitationMm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precipitationmm"
          },
          "windSpeedMs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Windspeedms"
          },
          "windDirectionDeg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Winddirectiondeg"
          },
          "weatherSymbol": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weathersymbol"
          }
        },
        "type": "object",
        "required": [
          "available",
          "message",
          "time",
          "temperatureC",
          "precipitationMm",
          "windSpeedMs",
          "windDirectionDeg",
          "weatherSymbol"
        ],
        "title": "WeatherForecast",
        "description": "What the UI shows: either the values or available=False with a message."
      }
    }
  }
}
